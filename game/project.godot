; Engine configuration file.
; Ver .agents/dev_guidelines.md antes de cambiar ajustes.

config_version=5

[application]

config/name="Can you destroy it?"
config/description="Incremental mágico en primera persona y pixel art."
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Events="*res://autoload/events.gd"
Settings="*res://autoload/settings.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"
AudioDirector="*res://autoload/audio_director.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[input]

cast_left={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1,"pressed":true)]
}
cast_right={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2,"pressed":true)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
cycle_element_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
cycle_element_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
open_grimoire={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
