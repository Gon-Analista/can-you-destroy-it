[ext_resource type="Script" path="res://data/defs/upgrade_node.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"arcane_power"
display_name = "Potencia"
description = "Golpes arcanos más fuertes y más ecos (dos a nivel 3, tres a nivel 6, cuatro a nivel 9). Desde el nivel 6 salen de la mano con círculos de runas."
