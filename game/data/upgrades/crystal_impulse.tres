costs = PackedInt32Array(1500, 5000, 15000)
prerequisites = Array[StringName]([&"levitation"])
stat = &"levitation_refill"
values = PackedFloat32Array(0, 0.25, 0.45, 0.7)
value_format = "+%.2f s por golpe"
level_names = PackedStringArray("Sin impulso")
