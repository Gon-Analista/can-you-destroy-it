[gd_resource type="Resource" script_class="UpgradeNode" format=3]

[ext_resource type="Script" path="res://data/defs/upgrade_node.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"spark_power"
display_name = "Potencia"
description = "La chispa arde más: más daño, más rápida y fragmentos más grandes. Desde el nivel 6 sale de la mano con círculos de runas."
