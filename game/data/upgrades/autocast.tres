[gd_resource type="Resource" script_class="UpgradeNode" format=3]

[ext_resource type="Script" path="res://data/defs/upgrade_node.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"autocast"
display_name = "Lanzamiento continuo"
description = "Mantén pulsado un botón y esa mano lanza sola a su ritmo: tiembla, crepita y no para hasta que sueltas. Con una mano en ráfaga, pulsa la otra y se juntan."
branch = 1
element = &"spark"
star_pos = Vector2i(178, 44)
costs = PackedInt32Array(9000)
prerequisites = Array[StringName]([&"channeling", &"pylon:0.3"])
stat = &"autocast"
values = PackedFloat32Array(0, 1)
value_format = "%s"
level_names = PackedStringArray("Clic a clic", "En ráfaga al mantener")
