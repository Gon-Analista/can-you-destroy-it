[gd_resource type="Resource" script_class="UpgradeNode" format=3]

[ext_resource type="Script" path="res://data/defs/upgrade_node.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"rune_slots"
display_name = "Ranura de runa"
description = "Una ranura más en la Mesa de Runas: otra runa inscrita a la vez."
element = &"runes"
costs = PackedInt32Array(15000, 40000)
prerequisites = Array[StringName]([&"pylon:0.25"])
stat = &"rune_slots"
values = PackedFloat32Array(1, 2, 3)
value_format = "%d ranuras"
